# Production/on-prem pilot template.
# Generate every secret per installation. Values containing REPLACE_WITH will be rejected by backend validation.

NODE_ENV=production
PORT=3001
APP_VERSION=1.0.0
RELEASE_SHA=REPLACE_WITH_RELEASE_SHA

POSTGRES_USER=aardvarkland
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_DB_PASSWORD
POSTGRES_DB=aardvarkland_storage
POSTGRES_PORT=5432
# For docker-compose.prod.example.yml, use the Compose service hostname `postgres`.
# For a native Windows service backend outside Docker, change the host to `localhost`.
DATABASE_URL="postgresql://aardvarkland:REPLACE_WITH_GENERATED_DB_PASSWORD@postgres:5432/aardvarkland_storage?schema=public"
DATABASE_DIRECT_URL=""
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_LOCK_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=1mb

JWT_SECRET="REPLACE_WITH_GENERATED_JWT_SECRET_32_PLUS_CHARS"
JWT_KEY_ID="jwt-production-v1"
JWT_PREVIOUS_SECRETS=""
JWT_ISSUER="aardvarkland-storage-system"
JWT_AUDIENCE="aardvarkland-storage-system-api"
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

WEBHOOK_SHARED_SECRET="REPLACE_WITH_GENERATED_WEBHOOK_SECRET_32_PLUS_CHARS"
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
CARRIER_CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_GENERATED_CARRIER_KEY_32_PLUS_CHARS"
CARRIER_CREDENTIAL_ENCRYPTION_KEY_ID="carrier-production-v1"
CARRIER_CREDENTIAL_PREVIOUS_ENCRYPTION_KEYS=""
CARRIER_ADAPTER_MODE=credential
CARRIER_HTTP_TIMEOUT_MS=15000

CORS_ALLOWED_ORIGINS="http://localhost:3000"
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
ENABLE_DEMO_ROUTES=false
ENABLE_SWAGGER=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_LOGIN_MAX=20
RATE_LIMIT_AUTH_REFRESH_MAX=120
RATE_LIMIT_WEBHOOK_MAX=600
RATE_LIMIT_BACKEND=postgres
RATE_LIMIT_FAIL_OPEN=false
TRUST_PROXY_HOPS=0

HEALTH_OUTBOX_MAX_AGE_SECONDS=300
HEALTH_QUEUE_WORKER_MAX_AGE_SECONDS=300
HEALTH_REQUIRE_QUEUE_WORKER=true
HEALTH_CONSISTENCY_CHECK_ENABLED=true
HEALTH_CONSISTENCY_MAX_ERRORS=0
WMS_BACKUP_STATUS_PATH="/app/.runtime/backup-status.json"
HEALTH_BACKUP_MAX_AGE_SECONDS=108000
HEALTH_REQUIRE_BACKUP_STATUS=true
HEALTH_RESTORE_DRILL_MAX_AGE_SECONDS=604800
HEALTH_REQUIRE_RESTORE_DRILL=true
STARTUP_PREFLIGHT_STRICT=true
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_SECONDS=21600
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_AUTH_LOGIN_ATTEMPT_DAYS=30
RETENTION_RATE_LIMIT_BUCKET_DAYS=2
RETENTION_REFRESH_SESSION_DAYS=60
RETENTION_IDEMPOTENCY_DAYS=45
RETENTION_OUTBOX_SENT_DAYS=30
RETENTION_INBOX_TERMINAL_DAYS=30
RETENTION_PRINT_JOB_DAYS=90
RETENTION_INTEGRATION_LOG_DAYS=90
RETENTION_INTEGRATION_DEAD_LETTER_DAYS=180
EXTERNAL_HTTP_ALLOWED_HOSTS=""
AUTH_FAILED_LOGIN_BACKOFF_ENABLED=true
AUTH_FAILED_LOGIN_BACKOFF_THRESHOLD=5
AUTH_FAILED_LOGIN_BACKOFF_BASE_SECONDS=30
AUTH_FAILED_LOGIN_BACKOFF_MAX_SECONDS=900
AUTH_FAILED_LOGIN_BACKOFF_WINDOW_SECONDS=900

MFA_TOTP_ISSUER="Aardvarkland Storage System"
MFA_SECRET_ENCRYPTION_KEY="REPLACE_WITH_GENERATED_MFA_SECRET_32_PLUS_CHARS"
MFA_SECRET_ENCRYPTION_KEY_ID="storage-system-mfa-v1"
MFA_PREVIOUS_SECRET_ENCRYPTION_KEYS=""
PRIVILEGED_MFA_ENFORCEMENT=block
STRUCTURED_LOGS_ENABLED=true
OPERATIONAL_ALERT_DELIVERY_ENABLED=true
OPERATIONAL_ALERT_CHANNELS=windows-event-log,log
OPERATIONAL_ALERT_DEDUPE_MINUTES=15
OPERATIONAL_ALERT_WINDOWS_EVENT_SOURCE=Aardvarkland-WMS
OPERATIONAL_ALERT_WEBHOOK_URL=
OPERATIONAL_ALERT_WEBHOOK_SECRET=
OPERATIONAL_ALERT_SMTP_HOST=
OPERATIONAL_ALERT_SMTP_PORT=25
OPERATIONAL_ALERT_SMTP_SECURE=false
OPERATIONAL_ALERT_SMTP_USERNAME=
OPERATIONAL_ALERT_SMTP_PASSWORD=
OPERATIONAL_ALERT_SMTP_FROM=
OPERATIONAL_ALERT_SMTP_TO=
SLOW_ROUTE_WARN_MS=1000
SLOW_ROUTE_CRITICAL_MS=3000
HTTP_5XX_RATE_WARN_PER_MINUTE=10
INTEGRATION_CIRCUIT_BREAKER_ENABLED=true
INTEGRATION_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
INTEGRATION_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

ALLOW_DEMO_SEED=false
WMS_QUEUE_WORKER_TAKE=50
WMS_QUEUE_WORKER_ID=prod-queue-worker
WMS_QUEUE_WORKER_POLL_INTERVAL_MS=5000
WMS_QUEUE_WORKER_MAX_ATTEMPTS=5
WMS_QUEUE_WORKER_RETRY_DELAY_SECONDS=60
DATABASE_RUNTIME_ROLE=aardvarkland_storage_runtime
