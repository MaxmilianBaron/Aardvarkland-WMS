{
  "name": "@aardvarkland-inc/storage-system-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Aardvarkland Storage System backend API.",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:prod": "node dist/main.js",
    "start:queue": "node dist/queue-worker.main.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js src test prisma/seed.ts --max-warnings=0 --ignore-pattern \"src/generated/**\"",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test test/**/*.test.ts",
    "test:e2e:live": "node scripts/live-api-e2e.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit",
    "typecheck:scripts": "node ./node_modules/typescript/bin/tsc -p tsconfig.seed.json --noEmit",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:status": "node ./node_modules/prisma/build/index.js migrate status",
    "prisma:studio": "node ./node_modules/prisma/build/index.js studio",
    "db:seed": "npm run prisma:generate && node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "permissions:check": "node ./node_modules/tsx/dist/cli.mjs scripts/check-seed-permissions.ts",
    "openapi:export": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.scripts.json --transpile-only scripts/export-openapi.ts",
    "worker:queue": "node -r ts-node/register -r tsconfig-paths/register src/queue-worker.main.ts",
    "verify": "npm run prisma:generate && npm run typecheck && npm run typecheck:scripts && npm run lint && npm test && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "17.4.2",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.21",
    "@types/node": "25.6.2",
    "@types/pg": "8.20.0",
    "embedded-postgres": "^18.3.0-beta.17",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "prisma": "7.9.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "hono": "4.12.30",
    "deepmerge-ts": "8.0.0"
  }
}
