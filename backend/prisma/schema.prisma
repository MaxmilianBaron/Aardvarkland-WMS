model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique
  displayName          String                @map("display_name")
  passwordHash         String                @map("password_hash")
  status               UserStatus            @default(ACTIVE)
  sessionVersion       Int                   @default(0) @map("session_version")
  roles                UserRole[]
  auditLogs            AuditLog[]            @relation("ActorAuditLogs")
  trackingEvents       TrackingEvent[]       @relation("ActorTrackingEvents")
  createdExceptions    WmsException[]        @relation("CreatedExceptions")
  stockMovements       StockMovement[]       @relation("ActorStockMovements")
  serialNumberEvents   SerialNumberEvent[]   @relation("ActorSerialNumberEvents")
  assignedTasks        WarehouseTask[]       @relation("AssignedWarehouseTasks")
  labelPrintJobs       LabelPrintJob[]       @relation("RequestedLabelPrintJobs")
  notifications        Notification[]
  clientAccess         UserClientAccess[]
  refreshTokenSessions RefreshTokenSession[]
  mfaTotpSecrets       MfaTotpSecret[]
  authLoginAttempts    AuthLoginAttempt[]
  workContext          UserWorkContext?
  lastLoginAt          DateTime?             @map("last_login_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([userId, roleId, warehouseId])
  @@index([warehouseId])
  @@map("user_roles")
}

model UserWorkContext {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  warehouseId            String    @map("warehouse_id") @db.Uuid
  zone                   String?
  shiftCode              String?   @map("shift_code")
  rfMode                 String    @default("DESKTOP") @map("rf_mode")
  scannerDeviceReference String?   @map("scanner_device_reference")
  metadata               Json?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([warehouseId])
  @@map("user_work_contexts")
}

model WmsClient {
  id                       String                     @id @default(uuid()) @db.Uuid
  code                     String                     @unique
  name                     String
  status                   WmsClientStatus            @default(ACTIVE)
  billingCurrency          String                     @default("EUR") @map("billing_currency")
  externalReference        String?                    @map("external_reference")
  metadata                 Json?
  warehouses               ClientWarehouse[]
  skuAliases               ClientSkuAlias[]
  resourceLinks            ClientResourceLink[]
  billingEvents            BillingEvent[]
  billingInvoices          BillingInvoice[]
  billingCreditNotes       BillingCreditNote[]
  ownedInboundShipments    InboundShipment[]          @relation("InboundShipmentOwnerClient")
  ownedOutboundOrders      OutboundOrder[]            @relation("OutboundOrderOwnerClient")
  ownedHandlingUnits       HandlingUnit[]             @relation("HandlingUnitOwnerClient")
  ownedStockQuants         StockQuant[]               @relation("StockQuantOwnerClient")
  ownedReservations        Reservation[]              @relation("ReservationOwnerClient")
  ownedWarehouseTasks      WarehouseTask[]            @relation("WarehouseTaskOwnerClient")
  ownedStockMovements      StockMovement[]            @relation("StockMovementOwnerClient")
  ownedShipments           Shipment[]                 @relation("ShipmentOwnerClient")
  ownedShipmentPackages    ShipmentPackage[]          @relation("ShipmentPackageOwnerClient")
  ownedCarrierLabels       CarrierLabel[]             @relation("CarrierLabelOwnerClient")
  ownedPickWaves           PickWave[]                 @relation("PickWaveOwnerClient")
  ownedSkuLots             SkuLot[]                   @relation("SkuLotOwnerClient")
  ownedSerialNumbers       SerialNumber[]             @relation("SerialNumberOwnerClient")
  ownedSerialNumberEvents  SerialNumberEvent[]        @relation("SerialNumberEventOwnerClient")
  ownedWarehouseOrders     WarehouseOrder[]           @relation("WarehouseOrderOwnerClient")
  ownedWarehouseOrderLines WarehouseOrderLine[]       @relation("WarehouseOrderLineOwnerClient")
  ownedWarehouseOrderTasks WarehouseOrderTask[]       @relation("WarehouseOrderTaskOwnerClient")
  periodCloses             BillingPeriodClose[]
  storageSnapshots         StorageOccupancySnapshot[]
  invoiceSequences         InvoiceNumberSequence[]
  rateCards                ClientRateCard[]
  userAccess               UserClientAccess[]
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")

  @@index([status])
  @@map("wms_clients")
}

model ClientWarehouse {
  id                    String    @id @default(uuid()) @db.Uuid
  clientId              String    @map("client_id") @db.Uuid
  warehouseId           String    @map("warehouse_id") @db.Uuid
  isActive              Boolean   @default(true) @map("is_active")
  defaultBillingProfile String?   @map("default_billing_profile")
  externalReference     String?   @map("external_reference")
  metadata              Json?
  client                WmsClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([clientId, warehouseId])
  @@index([warehouseId, isActive])
  @@map("client_warehouses")
}

model ClientSkuAlias {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  warehouseId   String?   @map("warehouse_id") @db.Uuid
  skuId         String?   @map("sku_id") @db.Uuid
  clientSku     String    @map("client_sku")
  clientBarcode String?   @map("client_barcode")
  description   String?
  metadata      Json?
  client        WmsClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([clientId, clientSku])
  @@index([warehouseId, skuId])
  @@index([clientBarcode])
  @@map("client_sku_aliases")
}

model ClientResourceLink {
  id                String    @id @default(uuid()) @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  warehouseId       String    @map("warehouse_id") @db.Uuid
  resourceType      String    @map("resource_type")
  resourceId        String    @map("resource_id")
  externalReference String?   @map("external_reference")
  metadata          Json?
  client            WmsClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([warehouseId, resourceType, resourceId])
  @@index([clientId, resourceType])
  @@index([warehouseId, clientId])
  @@map("client_resource_links")
}

model UserClientAccess {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  clientId    String     @map("client_id") @db.Uuid
  warehouseId String?    @map("warehouse_id") @db.Uuid
  isActive    Boolean    @default(true) @map("is_active")
  metadata    Json?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      WmsClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([userId, clientId, warehouseId])
  @@index([clientId, warehouseId, isActive])
  @@map("user_client_access")
}

model ClientRateCard {
  id          String       @id @default(uuid()) @db.Uuid
  clientId    String       @map("client_id") @db.Uuid
  warehouseId String       @map("warehouse_id") @db.Uuid
  name        String
  currency    String       @default("EUR")
  validFrom   DateTime     @map("valid_from")
  validTo     DateTime?    @map("valid_to")
  isActive    Boolean      @default(true) @map("is_active")
  metadata    Json?
  client      WmsClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  rates       ClientRate[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([warehouseId, clientId, isActive, validFrom])
  @@map("client_rate_cards")
}

model ClientRate {
  id             String           @id @default(uuid()) @db.Uuid
  rateCardId     String           @map("rate_card_id") @db.Uuid
  eventType      BillingEventType @map("event_type")
  unit           String           @default("EA")
  unitPriceMinor Int              @map("unit_price_minor")
  minChargeMinor Int?             @map("min_charge_minor")
  vatRateBps     Int?             @map("vat_rate_bps")
  metadata       Json?
  rateCard       ClientRateCard   @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([rateCardId, eventType, unit])
  @@index([eventType])
  @@map("client_rates")
}

model InvoiceNumberSequence {
  id          String     @id @default(uuid()) @db.Uuid
  warehouseId String     @map("warehouse_id") @db.Uuid
  clientId    String?    @map("client_id") @db.Uuid
  prefix      String
  year        Int
  nextNumber  Int        @default(1) @map("next_number")
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  client      WmsClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([warehouseId, clientId, year, prefix])
  @@map("invoice_number_sequences")
}

model StorageOccupancySnapshot {
  id                String    @id @default(uuid()) @db.Uuid
  warehouseId       String    @map("warehouse_id") @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  skuId             String?   @map("sku_id") @db.Uuid
  locationId        String?   @map("location_id") @db.Uuid
  stockQuantId      String?   @map("stock_quant_id") @db.Uuid
  quantity          Int       @default(0)
  handlingUnitCount Int?      @map("handling_unit_count")
  palletCount       Int?      @map("pallet_count")
  snapshotDate      DateTime  @map("snapshot_date") @db.Date
  metadata          Json?
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  client            WmsClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([warehouseId, clientId, skuId, locationId, stockQuantId, snapshotDate])
  @@index([warehouseId, clientId, snapshotDate])
  @@map("storage_occupancy_snapshots")
}

model BillingPeriodClose {
  id          String              @id @default(uuid()) @db.Uuid
  warehouseId String              @map("warehouse_id") @db.Uuid
  clientId    String              @map("client_id") @db.Uuid
  periodStart DateTime            @map("period_start")
  periodEnd   DateTime            @map("period_end")
  status      BillingPeriodStatus @default(OPEN)
  closedAt    DateTime?           @map("closed_at")
  closedBy    String?             @map("closed_by") @db.Uuid
  metadata    Json?
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  client      WmsClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([warehouseId, clientId, periodStart, periodEnd])
  @@index([warehouseId, clientId, status])
  @@map("billing_period_closes")
}

model BillingEvent {
  id             String              @id @default(uuid()) @db.Uuid
  clientId       String              @map("client_id") @db.Uuid
  warehouseId    String              @map("warehouse_id") @db.Uuid
  eventType      BillingEventType    @map("event_type")
  status         BillingEventStatus  @default(PENDING)
  reference      String              @default(uuid())
  resourceType   String?             @map("resource_type")
  resourceId     String?             @map("resource_id")
  description    String?
  quantity       Int                 @default(1)
  unitPriceMinor Int                 @default(0) @map("unit_price_minor")
  amountMinor    Int                 @default(0) @map("amount_minor")
  currency       String              @default("EUR")
  occurredAt     DateTime            @default(now()) @map("occurred_at")
  invoicedAt     DateTime?           @map("invoiced_at")
  voidedAt       DateTime?           @map("voided_at")
  metadata       Json?
  client         WmsClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceLine    BillingInvoiceLine?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([clientId, reference])
  @@index([warehouseId, status, occurredAt])
  @@index([clientId, status, occurredAt])
  @@index([resourceType, resourceId])
  @@map("billing_events")
}

model BillingInvoice {
  id               String               @id @default(uuid()) @db.Uuid
  clientId         String               @map("client_id") @db.Uuid
  warehouseId      String               @map("warehouse_id") @db.Uuid
  invoiceNumber    String               @map("invoice_number")
  status           BillingInvoiceStatus @default(DRAFT)
  periodStart      DateTime             @map("period_start")
  periodEnd        DateTime             @map("period_end")
  currency         String               @default("EUR")
  subtotalMinor    Int                  @default(0) @map("subtotal_minor")
  taxTotalMinor    Int                  @default(0) @map("tax_total_minor")
  totalAmountMinor Int                  @default(0) @map("total_amount_minor")
  finalizedAt      DateTime?            @map("finalized_at")
  voidedAt         DateTime?            @map("voided_at")
  metadata         Json?
  client           WmsClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  warehouse        Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines            BillingInvoiceLine[]
  creditNotes      BillingCreditNote[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([clientId, invoiceNumber])
  @@index([warehouseId, clientId, status, periodStart])
  @@map("billing_invoices")
}

model BillingInvoiceLine {
  id               String                  @id @default(uuid()) @db.Uuid
  invoiceId        String                  @map("invoice_id") @db.Uuid
  billingEventId   String?                 @unique @map("billing_event_id") @db.Uuid
  lineNumber       Int                     @map("line_number")
  eventType        String                  @map("event_type")
  description      String
  quantity         Int                     @default(1)
  amountMinor      Int                     @default(0) @map("amount_minor")
  vatRateBps       Int?                    @map("vat_rate_bps")
  netAmountMinor   Int                     @default(0) @map("net_amount_minor")
  taxAmountMinor   Int                     @default(0) @map("tax_amount_minor")
  grossAmountMinor Int                     @default(0) @map("gross_amount_minor")
  currency         String                  @default("EUR")
  metadata         Json?
  invoice          BillingInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billingEvent     BillingEvent?           @relation(fields: [billingEventId], references: [id], onDelete: SetNull)
  creditNoteLines  BillingCreditNoteLine[]
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@unique([invoiceId, lineNumber])
  @@index([invoiceId])
  @@index([eventType])
