{
  "name": "@aardvarkland-inc/live-frontend-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repo-local MCP server for live-like Aardvarkland frontend checks.",
  "bin": {
    "aardvarkland-live-frontend-mcp": "./server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "smoke": "node smoke.mjs",
    "role:journeys": "node run-role-journeys.mjs",
    "shift:stress": "node run-shift-stress.mjs",
    "shift:gate30": "node run-shift-stress.mjs --readiness-gate=30m --run-mode=persistent --workers=10 --screenshots=false --audit=false --hardware-lab=true",
    "shift:gate60": "node run-shift-stress.mjs --readiness-gate=60m --run-mode=persistent --workers=10 --screenshots=false --audit=false --hardware-lab=true",
    "live:process": "node run-live-process.mjs",
    "hardware:sim": "node run-hardware-sim-lab.mjs",
    "hardware:ui": "node hardware-sim-ui.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
